#  Smart Fridge Alexa -- configuration.  Copy to .env (Windows: copy .env.example .env).
#  REQUIRED: only ANTHROPIC_API_KEY.  Everything else has a working default.


# ---- REQUIRED ------------------------------------------------------------------------
# Used by the image classifier, the dish agent and the Alexa+ simulator.
ANTHROPIC_API_KEY=

# ---- Which LLM to use (defaults: Anthropic) -------------------------------------------
# anthropic | bedrock | openai | auto | demo/rules (no key, limited)
#   auto = Bedrock (if AWS credentials exist) -> Anthropic -> OpenAI -> built-in fallback
# Alexa+ simulator brain
LLM_PROVIDER=anthropic
# dish agent
AGENT_LLM_PROVIDER=anthropic
AGENT_ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Where the camera/classifier API is (default: the classifier on this machine) ------
# Start it with:  python -m classifier.api.main      (port 9000)
EDGE_URL=http://127.0.0.1:9000
EDGE_API_KEY=
EDGE_TIMEOUT=2.0
EDGE_POLL_SECONDS=10

# ---- Ports and paths (defaults ok) -----------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8899
SIM_PORT=8898
MCP_URL=http://127.0.0.1:8899/mcp
AGENT_URL=http://127.0.0.1:8897
FRIDGE_STATE_PATH=shared/fridge_state.json
SHOPPING_LIST_PATH=shared/shopping_list.json

# ---- Timeouts (defaults ok) -----------------------------------------------------
# seconds the MCP server waits for the dish agent
AGENT_TIMEOUT=20
# seconds one Bedrock/Strands dish-agent run may take before falling back
AGENT_RUN_TIMEOUT=8
# Bedrock simulator turn: max seconds and max tool calls before falling back
SIM_RUN_TIMEOUT=12
SIM_MAX_TOOL_CALLS=6
# a provider that fails with an access/quota/auth error or times out is skipped this long
LLM_COOLDOWN_SECONDS=300

# ---- Logging --------------------------------------------------------------------------
LOG_LEVEL=normal

# ---- Security (leave empty when running locally) ---------------------------------------
# Alexa+ -> /mcp bearer token
MCP_API_KEY=
# classifier -> /api/inventory bearer token
INGEST_API_KEY=

# ---- OPTIONAL: Amazon Bedrock via the Strands Agents SDK -------------------------------
# Use with LLM_PROVIDER / AGENT_LLM_PROVIDER = bedrock or auto. Either a Bedrock API key:
AWS_BEARER_TOKEN_BEDROCK=
# ...or normal IAM keys (leave the bearer token line EMPTY or delete it):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Your account must be allowed to call these (check with: python scripts/check_bedrock.py)
BEDROCK_AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_SIM_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# ---- OPTIONAL: OpenAI as an extra fallback ----------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_OPENAI_MODEL=gpt-4o-mini
