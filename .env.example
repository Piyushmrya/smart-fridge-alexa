# ---- MCP server (:8899) ----
# classifier teammate's API, e.g. http://192.168.1.50:8000  (empty = legacy push mode)
EDGE_URL=
EDGE_API_KEY=
EDGE_TIMEOUT=2.0
EDGE_POLL_SECONDS=10
FRIDGE_STATE_PATH=shared/fridge_state.json
SHOPPING_LIST_PATH=shared/shopping_list.json
MCP_HOST=127.0.0.1
MCP_PORT=8899
# Alexa+ -> /mcp bearer token (leave empty locally)
MCP_API_KEY=
# classifier -> /api/inventory bearer token (leave empty locally)
INGEST_API_KEY=
AGENT_URL=http://127.0.0.1:8897
# seconds the MCP server waits for the dish agent (Bedrock tool-using runs take ~5-15 s)
AGENT_TIMEOUT=20

# ---- Dish AI agent (:8897) ----   AGENT_LLM_PROVIDER: rules (no key) | bedrock | anthropic | openai
AGENT_LLM_PROVIDER=rules
# max seconds for one Strands agent run before falling back
AGENT_RUN_TIMEOUT=18
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-4o-mini

# ---- Alexa+ simulator (:8898) ----   LLM_PROVIDER: demo (keyword router) | anthropic | openai
MCP_URL=http://127.0.0.1:8899/mcp
SIM_PORT=8898
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Logging ----
# quiet = problems only | normal = one line per step | debug = also full arguments/results
LOG_LEVEL=normal

# ---- Amazon Bedrock (Strands Agents SDK) ----
# Long-term Bedrock API key (console > Bedrock > API keys). Never commit it.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_SIM_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
